#!/bin/bash
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l walltime=04:00:00
#PBS -l jobfs=1GB
#PBS -l wd
#PBS -j oe
#PBS -N refugia-agcd
## AGCD daily 0.05 deg to S2 level 10 cell sums for the pilot regions.
## Run from a clone of the refugia repo on Gadi (git pull first):
##
##   qsub -P gv90 -l storage=gdata/zv2+gdata/jk72 \
##        -v AGCD_DIR=/g/data/zv2/agcd/v1-0-4,VARS=tmax:tmax,tmin:tmin,precip:precip gadi/agcd_sums.pbs
##
## AGCD_DIR holds <var>/... ; each VARS item is <dir>:<netcdf variable> and the
## files are taken as $AGCD_DIR/<dir>/**/r005/01day/*.nc (adjust GLOB_TAIL).
## Output: $OUTDIR/agcd_<var>_<region>_<year>_L10.rds (small, rsync or git them back).
## Resumable: rerun the same command if it hits walltime.
set -euo pipefail
module load singularity
SIF=${SIF:-/g/data/jk72/$USER/sif_lib/gdal-r-python-extras_latest.sif}
[ -f "$SIF" ] || { echo "no image at $SIF" >&2; exit 1; }
: "${AGCD_DIR:?set AGCD_DIR (see gadi/agcd_probe.sh)}"
VARS=${VARS:-tmax:tmax,precip:precip}
GLOB_TAIL=${GLOB_TAIL:-mean/r005/01day/*.nc}
OUTDIR=${OUTDIR:-/g/data/jk72/$USER/refugia/agcd_L10}
mkdir -p "$OUTDIR"
export SINGULARITYENV_R_LIBS_USER=/nonexistent SINGULARITYENV_R_LIBS= SINGULARITYENV_PYTHONNOUSERSITE=1
for item in ${VARS//,/ }; do
  d=${item%%:*}; v=${item##*:}
  g="$AGCD_DIR/$d/$GLOB_TAIL"
  [ "$d" = precip ] && g="$AGCD_DIR/$d/${GLOB_TAIL/mean/total}"
  echo "start $(date -Is) $v from $g"
  singularity exec -B /g/data "$SIF" Rscript gadi/agcd_sums.R "$g" "$v" "$OUTDIR" 10
done
echo "done $(date -Is): $(ls "$OUTDIR" | wc -l) files in $OUTDIR"
